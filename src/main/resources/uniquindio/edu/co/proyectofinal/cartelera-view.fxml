<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20.0" style="-fx-background-color: #F4F4F4;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.edu.co.proyectofinal.viewController.CarteleraViewController">
    <padding>
        <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
    </padding>
    <children>
        <Label text="CARTELERA • PELÍCULAS DISPONIBLES" textFill="#222222">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <!-- Contenedor con desplazamiento para las tarjetas de películas -->
        <ScrollPane fitToWidth="true" style="-fx-background: #F4F4F4; -fx-background-color: #F4F4F4;" VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="flowPanePeliculas" hgap="20.0" vgap="20.0">
                    <padding>
                        <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
                    </padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </children>
</VBox>