<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="borderPanePrincipal" prefHeight="720.0" prefWidth="1024.0" style="-fx-background-color: #F4F4F4;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.edu.co.proyectofinal.viewController.PrincipalViewController">

    <!-- BARRA SUPERIOR ESTILO CINEMARK -->
    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <!-- Franja superior oscura -->
                <HBox alignment="CENTER_RIGHT" prefHeight="28.0" spacing="15.0" style="-fx-background-color: #1C1C1C;">
                    <padding>
                        <Insets right="25.0" />
                    </padding>
                    <children>
                        <Label text="SEDE ARMENIA • UNIVERSIDAD DEL QUINDÍO" textFill="#CCCCCC">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <!-- Barra blanca principal con logo y menú -->
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 8, 0, 0, 2);">
                    <padding>
                        <Insets left="25.0" right="25.0" />
                    </padding>
                    <children>
                        <VBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="CINEMAUQ" textFill="#C8102E">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                                <Label text="ARMENIA" textFill="#555555">
                                    <font>
                                        <Font size="11.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <Separator orientation="VERTICAL" prefHeight="40.0" />

                        <Button fx:id="btnCartelera" mnemonicParsing="false" onAction="#mostrarCartelera" style="-fx-background-color: transparent; -fx-font-weight: bold; -fx-cursor: hand;" text="CARTELERA" textFill="#333333" />
                        <Button fx:id="btnFunciones" mnemonicParsing="false" onAction="#mostrarFunciones" style="-fx-background-color: transparent; -fx-font-weight: bold; -fx-cursor: hand;" text="FUNCIONES" textFill="#333333" />
                        <Button fx:id="btnVentas" mnemonicParsing="false" onAction="#mostrarVentas" style="-fx-background-color: transparent; -fx-font-weight: bold; -fx-cursor: hand;" text="VENTA DE BOLETAS" textFill="#333333" />
                        <Button fx:id="btnSalas" mnemonicParsing="false" onAction="#mostrarSalas" style="-fx-background-color: transparent; -fx-font-weight: bold; -fx-cursor: hand;" text="SALAS Y ASIENTOS" textFill="#333333" />
                        <Button fx:id="btnGestionVentas" mnemonicParsing="false" onAction="#mostrarVentasPersona" style="-fx-background-color: transparent; -fx-font-weight: bold; -fx-cursor: hand;" text="VENTAS" textFill="#333333" />
                        <Button fx:id="btnPersonas" mnemonicParsing="false" onAction="#mostrarGestionPersonas" style="-fx-background-color: transparent; -fx-font-weight: bold; -fx-cursor: hand;" text="GESTIÓN PERSONAS" textFill="#333333">
                            <padding>
                                <Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
                            </padding>
                        </Button>
                        <Button fx:id="btnGestionPeliculas" mnemonicParsing="false" onAction="#mostrarGestionPeliculas" style="-fx-background-color: transparent; -fx-font-weight: bold; -fx-cursor: hand;" text="GESTIÓN PELÍCULAS" textFill="#333333" />
                        <Button fx:id="btnReportes" mnemonicParsing="false" onAction="#mostrarReportes" style="-fx-background-color: #C8102E; -fx-background-radius: 20; -fx-font-weight: bold; -fx-cursor: hand;" text="REPORTES ADMIN" textFill="WHITE">
                            <padding>
                                <Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
                            </padding>
                        </Button>
                        <!-- Botón para alternar entre Operador y Administrador -->
                        <Button fx:id="btnCambiarRol" mnemonicParsing="false" onAction="#cambiarRol"
                                style="-fx-background-color: #34495E; -fx-background-radius: 20; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="ROL: ADMIN" textFill="WHITE">
                            <padding>
                                <Insets bottom="6.0" left="14.0" right="14.0" top="6.0" />
                            </padding>
                        </Button>
                        <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#salirAplicacion" style="-fx-background-color: #1C1C1C; -fx-background-radius: 20; -fx-font-weight: bold; -fx-cursor: hand;" text="SALIR" textFill="WHITE">
                            <padding>
                                <Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
                            </padding>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <!-- CONTENIDO CENTRAL CON TARJETAS DE REPORTES Y GESTIÓN DE FUNCIONES -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #F4F4F4; -fx-background-color: #F4F4F4;" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="25.0">
                    <padding>
                        <Insets bottom="35.0" left="35.0" right="35.0" top="25.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <Label text="PANEL DE CONTROL Y ESTADÍSTICAS" textFill="#222222">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <Button mnemonicParsing="false" onAction="#actualizarReportes" style="-fx-background-color: #C8102E; -fx-background-radius: 4; -fx-font-weight: bold; -fx-cursor: hand;" text="ACTUALIZAR DATOS" textFill="WHITE">
                                    <padding>
                                        <Insets bottom="7.0" left="18.0" right="18.0" top="7.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>

                        <!-- Fila de 3 Tarjetas KPI -->
                        <HBox spacing="20.0">
                            <children>
                                <!-- Tarjeta 1: Entradas vendidas -->
                                <VBox prefHeight="155.0" prefWidth="280.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 10, 0, 0, 3);" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER" prefHeight="34.0" style="-fx-background-color: #C8102E; -fx-background-radius: 6 6 0 0;">
                                            <children>
                                                <Label text="ENTRADAS VENDIDAS" textFill="WHITE">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </HBox>
                                        <VBox alignment="CENTER" prefHeight="121.0" spacing="6.0">
                                            <children>
                                                <Label fx:id="lblTotalEntradas" text="0" textFill="#1C1C1C">
                                                    <font>
                                                        <Font name="System Bold" size="36.0" />
                                                    </font>
                                                </Label>
                                                <Label text="Boletas activas en sistema" textFill="#777777" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <!-- Tarjeta 2: Ingresos generados -->
                                <VBox prefHeight="155.0" prefWidth="280.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 10, 0, 0, 3);" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER" prefHeight="34.0" style="-fx-background-color: #1C1C1C; -fx-background-radius: 6 6 0 0;">
                                            <children>
                                                <Label text="INGRESOS GENERADOS" textFill="WHITE">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </HBox>
                                        <VBox alignment="CENTER" prefHeight="121.0" spacing="6.0">
                                            <children>
                                                <Label fx:id="lblTotalIngresos" text="\$ 0" textFill="#C8102E">
                                                    <font>
                                                        <Font name="System Bold" size="32.0" />
                                                    </font>
                                                </Label>
                                                <Label text="Total recaudado (Ventas activas)" textFill="#777777" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <!-- Tarjeta 3: Película Más Vendida -->
                                <VBox prefHeight="155.0" prefWidth="320.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.12), 10, 0, 0, 3);" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER" prefHeight="34.0" style="-fx-background-color: #C8102E; -fx-background-radius: 6 6 0 0;">
                                            <children>
                                                <Label text="PELÍCULA MÁS VENDIDA" textFill="WHITE">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </HBox>
                                        <VBox alignment="CENTER" prefHeight="121.0" spacing="6.0">
                                            <padding>
                                                <Insets left="12.0" right="12.0" />
                                            </padding>
                                            <children>
                                                <Label fx:id="lblPeliculaMasVendida" text="Sin ventas" textAlignment="CENTER" textFill="#1C1C1C" wrapText="true">
                                                    <font>
                                                        <Font name="System Bold" size="20.0" />
                                                    </font>
                                                </Label>
                                                <Label fx:id="lblDetallePeliculaTop" text="Mayor demanda en cartelera" textFill="#777777" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
