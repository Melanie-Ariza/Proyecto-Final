<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox spacing="25.0" style="-fx-background-color: #F4F4F4;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.edu.co.proyectofinal.viewController.SalasViewController">
    <padding>
        <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
    </padding>
    <children>
        <!-- Panel Izquierdo: Lista de Salas y Botón de Modo -->
        <VBox spacing="15.0" prefWidth="280.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="SALAS" textFill="#222222">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnCambiarModo" mnemonicParsing="false" onAction="#cambiarModo" style="-fx-background-color: #C8102E; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Modo: Vista" />
                    </children>
                </HBox>
                <ListView fx:id="listSalas" prefHeight="400.0" style="-fx-background-radius: 6;" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>

        <!-- Panel Derecho: StackPane para alternar entre Vista de Asientos y CRUD de Salas -->
        <StackPane HBox.hgrow="ALWAYS">
            <children>
                <!-- PANEL 1: MODO VISUALIZACIÓN DE ASIENTOS -->
                <VBox fx:id="panelVistaAsientos" alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                    </padding>
                    <children>

                        <!-- Título de la sala -->
                        <Label fx:id="lblTituloSala"
                               text="Selecciona una sala para ver su distribución"
                               textFill="#C8102E">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>

                        <!-- Pantalla de cine fija -->
                        <Pane prefHeight="25.5"
                              minHeight="25.5"
                              maxHeight="25.5"
                              prefWidth="450.0"
                              style="-fx-background-color: #1C1C1C; -fx-background-radius: 3;" />

                        <Label text="PANTALLA" textFill="#888888">
                            <font>
                                <Font name="System Bold" size="10.0" />
                            </font>
                        </Label>

                        <Separator prefWidth="200.0" />

                        <!-- Aquí comienza el ScrollPane de los asientos -->

                        <!-- Cuadrícula Gráfica de Asientos -->
                        <ScrollPane fitToHeight="false" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <GridPane fx:id="gridAsientos" alignment="CENTER" hgap="10.0" vgap="10.0">
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </GridPane>
                            </content>
                        </ScrollPane>

                        <!-- Leyenda de colores -->
                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <HBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Pane prefHeight="15.0" prefWidth="15.0" style="-fx-background-color: #2ECC71; -fx-background-radius: 3;" />
                                        <Label text="Disponible" textFill="#444444" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Pane prefHeight="15.0" prefWidth="15.0" style="-fx-background-color: #E74C3C; -fx-background-radius: 3;" />
                                        <Label text="Ocupado" textFill="#444444" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Pane prefHeight="15.0" prefWidth="15.0" style="-fx-background-color: #9ea3a3; -fx-background-radius: 3;" />
                                        <Label text="Fuera de Servicio" textFill="#444444" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- PANEL 2: MODO GESTIÓN / CRUD DE SALAS -->
                <VBox fx:id="panelGestionSalas" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 8, 0, 0, 2);" visible="false" managed="false">
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                    </padding>
                    <children>
                        <Label text="GESTIÓN Y CONFIGURACIÓN DE SALAS" textFill="#C8102E">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Separator />
                        <GridPane hgap="15.0" vgap="15.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="140.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="300.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="30.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="30.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="30.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="30.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="30.0" prefHeight="35.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Código:" textFill="#333333" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>
                                <TextField fx:id="txtCodigo" promptText="Ej. 1" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Número de Sala:" textFill="#333333" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>
                                <TextField fx:id="txtNumero" promptText="Ej. 1" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Capacidad:" textFill="#333333" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>
                                <TextField fx:id="txtCapacidad" promptText="Ej. 80" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Estado:" textFill="#333333" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>
                                <ComboBox fx:id="cmbEstadoSala" prefWidth="300.0" promptText="Seleccione estado" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <Label text="Tipo de Asientos:" textFill="#333333" GridPane.columnIndex="0" GridPane.rowIndex="4">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>
                                <ComboBox fx:id="cmbColeccionAsientos" prefWidth="300.0" promptText="Seleccione tipo" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                            </children>
                        </GridPane>

                        <HBox alignment="CENTER" spacing="12.0">
                            <children>
                                <Button fx:id="btnRegistrarSalas" mnemonicParsing="false" onAction="#registrarSala" style="-fx-background-color: #2ECC71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Registrar" />
                                <Button fx:id="btnModificarSala" mnemonicParsing="false" onAction="#modificarSala" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Modificar" />
                                <Button fx:id="btnDeshabilitarSala" mnemonicParsing="false" onAction="#deshabilitarSala" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Deshabilitar" />
                                <Button fx:id="btnLimpiarSala" mnemonicParsing="false" onAction="#limpiarCamposSala" style="-fx-background-color: #7F8C8D; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Limpiar" />
                            </children>
                        </HBox>

                        <Label fx:id="lblMensajeSala" text="" textFill="#C8102E">
                            <font><Font size="12.0" /></font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</HBox>